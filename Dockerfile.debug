# 超简单的调试 Dockerfile
FROM node:18-slim

# 安装必要工具
RUN apt-get update && apt-get install -y curl procps && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 创建最简单的服务器来测试8080端口
RUN echo 'const express = require("express");\n\
const app = express();\n\
const port = process.env.HTTP_PORT || process.env.PORT || 8080;\n\
\n\
console.log("🚀 Starting simple server...");\n\
console.log("📊 Environment:");\n\
console.log("  NODE_ENV:", process.env.NODE_ENV);\n\
console.log("  PORT:", process.env.PORT);\n\
console.log("  HTTP_PORT:", process.env.HTTP_PORT);\n\
console.log("  Target port:", port);\n\
\n\
app.get("/", (req, res) => {\n\
  res.json({\n\
    message: "🎉 Xiaohongshu Automation - Debug Mode",\n\
    status: "running",\n\
    timestamp: new Date().toISOString(),\n\
    port: port,\n\
    env: {\n\
      NODE_ENV: process.env.NODE_ENV,\n\
      PORT: process.env.PORT,\n\
      HTTP_PORT: process.env.HTTP_PORT\n\
    }\n\
  });\n\
});\n\
\n\
app.get("/health", (req, res) => {\n\
  res.json({\n\
    status: "healthy",\n\
    service: "xiaohongshu-debug",\n\
    timestamp: new Date().toISOString(),\n\
    port: port\n\
  });\n\
});\n\
\n\
const server = app.listen(port, "0.0.0.0", () => {\n\
  console.log(`✅ Server successfully listening on 0.0.0.0:${port}`);\n\
  console.log(`🌐 Health check: http://localhost:${port}/health`);\n\
});\n\
\n\
server.on("error", (err) => {\n\
  console.error("❌ Server error:", err);\n\
  process.exit(1);\n\
});\n\
\n\
process.on("SIGTERM", () => {\n\
  console.log("📴 Received SIGTERM, shutting down gracefully");\n\
  server.close(() => {\n\
    console.log("✋ Server closed");\n\
    process.exit(0);\n\
  });\n\
});' > server.js

# 安装express
RUN npm init -y && npm install express

# 设置环境变量
ENV NODE_ENV=production
ENV PORT=8080
ENV HTTP_PORT=8080

# 暴露端口
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# 启动应用
CMD ["node", "server.js"]