# MCP Router 配置

# xiaohongshu-mcp 二进制文件路径
MCP_BINARY_PATH=./xiaohongshu-mcp

# Cookie 存储目录
COOKIE_DIR=./cookies

# 进程管理配置
MAX_PROCESSES=20
CLEANUP_TIMEOUT=600000
BASE_PORT=18060

# HTTP Server 配置
HTTP_PORT=3000

# 后端服务URL（用于从数据库加载Cookie）
# 生产环境：使用公网域名
# 开发环境：使用 localhost
# 如果不设置，默认使用 https://xiaohongshu-automation-ai.zeabur.app
# CLAUDE_AGENT_URL=https://xiaohongshu-automation-ai.zeabur.app
# BACKEND_URL=http://localhost:8080
