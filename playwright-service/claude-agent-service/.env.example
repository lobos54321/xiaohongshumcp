# ===== Zeabur 部署配置 =====
# 这些环境变量需要在Zeabur控制台中设置

# Claude API 配置 (必需)
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=4096

# Google Gemini API 配置 (图片生成必需)
GEMINI_API_KEY=your_gemini_api_key_here

# Unsplash API 配置 (可选，图片备用)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# 服务配置
PORT=8080
NODE_ENV=production

# MCP Router URL (生产环境自动配置)
# 在Zeabur上，MCP Router将作为独立服务运行
MCP_ROUTER_URL=http://mcp-router:3000

# ===== N8n UGC 工作流配置 =====
# N8n 工作流 Webhook URL (My workflow 14 入口)
N8N_UGC_WEBHOOK_URL=https://n8n-worker-k4m9.zeabur.app/webhook/9d5986f5-fcba-42bf-b3d7-5fd94660943a

# Agent 后端回调接收 URL (用于接收视频完成通知)
N8N_CALLBACK_URL=https://xiaohongshumcp.zeabur.app/api/ugc-video-callback

# ===== 本地开发配置 =====
# 本地开发时使用localhost
# MCP_ROUTER_URL=http://localhost:3000
