# 极简Dockerfile - 只运行Claude Agent Service
FROM node:18-alpine

WORKDIR /app

# 安装curl用于健康检查
RUN apk add --no-cache curl

# 复制package.json
COPY playwright-service/claude-agent-service/package*.json ./

# 安装依赖
RUN npm install --production

# 复制源代码
COPY playwright-service/claude-agent-service/src ./src
COPY playwright-service/claude-agent-service/tsconfig.json ./
COPY frontend ./frontend

# 编译TypeScript
RUN npm run build

# 暴露端口
EXPOSE 8080

# 设置环境变量
ENV NODE_ENV=production
ENV PORT=8080
ENV MCP_ROUTER_URL=http://localhost:3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# 直接启动服务器
CMD ["node", "dist/server.js"]