# Zeabur 部署时忽略的文件和目录

# 日志文件
*.log
logs/
tmp/

# 开发和测试文件
.env.local
.env.development
test-*.js
test-*.mjs
test-*.cjs
test/
tests/
*.test.js
*.spec.js

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 测试和开发工具
coverage/
.nyc_output/
playwright-report/
test-results/

# 本地cookies（生产环境会使用持久化存储）
cookies/
/Users/

# Go 语言相关文件（这是 Node.js 项目）
*.go
go.mod
go.sum
cmd/
internal/
pkg/

# 其他 Dockerfile（只使用生产版本）
Dockerfile.debug
Dockerfile.minimal
Dockerfile.ultra
Dockerfile.zeabur

# 构建缓存
.cache/
dist/*.map
*.tsbuildinfo

# Git 相关
.git/
.gitignore

# 文档（可选，如果不需要在生产环境中）
docs/
*.md
ZEABUR_ENV_SETUP.md
