# 最简化Dockerfile - 专门解决Zeabur部署问题
FROM node:18-alpine

# 安装必要工具
RUN apk add --no-cache curl bash

WORKDIR /app

# 只复制必要文件
COPY package*.json ./
COPY playwright-service/claude-agent-service/package*.json ./playwright-service/claude-agent-service/

# 安装依赖
RUN cd playwright-service/claude-agent-service && npm install --production

# 复制源代码
COPY playwright-service/claude-agent-service ./playwright-service/claude-agent-service
COPY frontend ./frontend

# 编译TypeScript
RUN cd playwright-service/claude-agent-service && npm run build

# 创建最简启动脚本
RUN echo '#!/bin/bash\n\
echo "🚀 Starting Xiaohongshu Automation (Minimal Mode)..."\n\
cd /app/playwright-service/claude-agent-service\n\
echo "📂 Current directory: $(pwd)"\n\
echo "📦 Files: $(ls -la dist/)"\n\
echo "🌐 Starting on port $PORT"\n\
MCP_ROUTER_URL=http://localhost:3000 node dist/server.js' > /app/start-minimal.sh

RUN chmod +x /app/start-minimal.sh

# 暴露端口
EXPOSE 8080

# 设置环境变量
ENV NODE_ENV=production
ENV PORT=8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# 使用简化启动脚本
CMD ["/app/start-minimal.sh"]